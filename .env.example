# GitHub: leave empty to use `gh auth token`. Otherwise a personal access token for YOUR account
# (classic: read:user, plus repo if you want private activity counted).
# The tool only ever reads the account this token belongs to.
GITHUB_TOKEN=

# Magic Hour: https://magichour.ai/developer?tab=api-keys (not needed for --dry-run)
MAGIC_HOUR_API_KEY=

# Script writing. Provider is inferred from the model id (claude-* = Anthropic, otherwise OpenAI).
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# Optional: reasoning effort (low|medium|high), and prices for models not in core/llm.py.
LLM_EFFORT=
LLM_USD_PER_MTOK_IN=
LLM_USD_PER_MTOK_OUT=

# Commits made without a UTC offset (web editor, CI) are read in this timezone, e.g. America/Toronto.
# Default: this machine's timezone.
ROAST_TIMEZONE=

# Pricing for cost reports: auto reads your plan from your Magic Hour account, or set a key from
# core/plans.py (creator-monthly, creator-annual, pro-monthly, pack, ...).
MAGIC_HOUR_PLAN=auto
MAGIC_HOUR_CREDITS_PER_USD=
